# DayPilot AI - Environment Configuration Example
# No private API keys or cloud credentials required for standard operation.

# MCP Server Port
PORT=3001

# Web Frontend Base Path (for GitHub Pages subpaths e.g. /daypilot-ai/)
VITE_BASE_PATH=./

# MCP Server Endpoint for Web App
VITE_MCP_SERVER_URL=http://localhost:3001
